rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    // Reject oversized or oddly shaped documents
    function sane() {
      return request.resource.data.keys().size() <= 25;
    }

    // Each user can only touch their own data, in the app's collections only
    match /users/{userId}/{col}/{docId} {
      allow read, delete: if isOwner(userId)
        && col in ['transactions','budgets','investments','accounts','goals','cards','subs'];
      allow create, update: if isOwner(userId)
        && col in ['transactions','budgets','investments','accounts','goals','cards','subs']
        && sane();
    }

    // Everything else is blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
